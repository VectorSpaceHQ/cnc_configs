loadrt debounce cfg=1
addf debounce.0 servo-thread
setp debounce.0.delay 100
addf ztouch_or servo-thread

#  ---probe signal---
#net probe hm2_5i25.0.7i84.0.0.input-08-not => motion.probe-input
net probe <= hm2_5i25.0.7i84.0.0.input-08-not
net probe => debounce.0.0.in
#net probe-debounced <= debounce.0.0.out
#net probe-debounced  => motion.probe-input

# Can't figure out another way to use this debounce pin twice.
#net probe2 debounce.0.0.out => debounce.1.0.in
# net another-debounce1  debounce.0.0.out   ztouch_or.in0
# net another-debounce2  debounce.0.0.out   ztouch_or.in1
# #net another-debounce   ztouch_or.out

# Z Probe
# Actual code is in ../subroutines/z_touch.ngc
net ztouch1 ztouch_clicked_and.in0   <= pyvcp.ztouch
net ztouch2 ztouch_clicked_and.in1    tool-probe.in1   <= debounce.0.0.out
net ztouch3 halui.mdi-command-03     <=    ztouch_clicked_and.out

# Must make sure motion.probe-input is FALSE whenever G38.4 is not being executed.
# This is done by adding a custom ditial-out-00 pin and setting it TRUE just before
# G38 and FALSE just after G38. Values are set directly in the .nc subroutine.
# This custom pin is used as an input to an AND that then feeds motion.probe-input.
net motion1               motion.digital-out-00                 tool-probe.in0
net motion3               tool-probe.out     motion.probe-input
