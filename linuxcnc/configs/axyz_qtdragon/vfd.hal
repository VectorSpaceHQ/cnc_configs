# Include your customized HAL commands here
# This file will not be overwritten when you run stepconf again
loadrt lincurve count=1 personality=7
addf lincurve.0 servo-thread


# loadrt scale names=spindle_fb_scale
# addf spindle_fb_scale servo-thread

# setp spindle_fb_scale.offset 0.103
# setp spindle_fb_scale.gain 40.9

# Set the Voltage points (X-axis)
setp lincurve.0.x-val-00 0.0
setp lincurve.0.y-val-00 0.0

setp lincurve.0.x-val-01 0.1423
setp lincurve.0.y-val-01 10.8

setp lincurve.0.x-val-02 0.7118
setp lincurve.0.y-val-02 30.7

setp lincurve.0.x-val-03 2.562
setp lincurve.0.y-val-03 87.0

setp lincurve.0.x-val-04 5.409
setp lincurve.0.y-val-04 175.0

setp lincurve.0.x-val-05 7.829
setp lincurve.0.y-val-05 252.0

setp lincurve.0.x-val-06 10.534
setp lincurve.0.y-val-06 335.0

# Connect the Mesa pin to the curve input
net spindle-voltage-raw hm2_7i76e.0.7i76.0.0.analogin0 => lincurve.0.in

# Connect the curve output to the display (and filter if you used one)
net spindle-speed-fb-rps lincurve.0.out => spindle.0.speed-in


